{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} · Penderie{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ 'login.title'|trans }}</h1>

        {% if error %}
            {# the message comes from Symfony's "security" translation domain, which exists in fr, en and ar #}
            <p class="error" role="alert" data-cy="login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <label for="username">{{ 'login.email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}"
                   autocomplete="email" required autofocus data-cy="login-email">

            <label for="password">{{ 'login.password'|trans }}</label>
            <input type="password" id="password" name="_password"
                   autocomplete="current-password" required data-cy="login-password">

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" data-cy="login-submit">{{ 'login.submit'|trans }}</button>
        </form>
    </div>
{% endblock %}
